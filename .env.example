# Copy to .env.local for local development. Never commit real values.
# Only names starting with NEXT_PUBLIC_ are ever sent to the browser or the app.

# --- Required on the server ---
# Your Anthropic API key. Server only. It is never included in the web bundle or the APK.
ANTHROPIC_API_KEY=
# Signs interview session tokens. At least 16 characters. Generate with: openssl rand -hex 32
SESSION_SECRET=

# --- Models (optional) ---
# Strong model: builds the interview and grades it. Fast model: live follow-up questions.
CLAUDE_MODEL_STRONG=claude-opus-5-5
CLAUDE_MODEL_FAST=claude-haiku-5-5
# Effort per task: low, medium, high, xhigh or max. Higher is slower and costs more.
CLAUDE_EFFORT_PLAN=medium
CLAUDE_EFFORT_GRADE=high
CLAUDE_EFFORT_FOLLOWUP=low
# If the strong model declines a request, Anthropic re-runs it on a fallback model (a beta feature). Set to "off" to disable.
CLAUDE_REFUSAL_FALLBACK=default

# --- Cost and abuse limits (optional, defaults shown) ---
MAX_INTERVIEWS_PER_DAY=5
GLOBAL_MAX_INTERVIEWS_PER_DAY=300
RATE_PLAN_PER_MINUTE=3
RATE_FOLLOWUP_PER_MINUTE=30
RATE_GRADE_PER_MINUTE=10
MAX_FOLLOWUPS_PER_INTERVIEW=60
MAX_GRADES_PER_INTERVIEW=40
# Header your host uses for the visitor's address. Vercel and most proxies: x-forwarded-for. Cloudflare: cf-connecting-ip.
CLIENT_IP_HEADER=x-forwarded-for

# --- Shared rate-limit store (needed on serverless hosts such as Vercel) ---
# Without these, counters live in the server's memory, which is only correct for a single long-running server.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Android app ---
# Origins allowed to call the API from another origin. The Android app's origin is https://localhost.
ALLOWED_ORIGINS=https://localhost,capacitor://localhost
# Used only when building the Android app's UI: the public HTTPS address of your deployed backend.
NEXT_PUBLIC_API_BASE_URL=

# --- Development only ---
# "mock" returns canned responses with no API key and no cost. Never use it in production.
AI_PROVIDER=
